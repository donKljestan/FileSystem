root> mkdir <name>              create a folder (root only)
create <name>             create an empty file
cd <folder>               change folder (also: cd .., cd root); CD goes to root
ls                        list the current folder
stat <name>               show i-node information
echo <file> <text>        write text to a file
cat <file>                print a file
rename <name> <new name>  rename a file or folder
rm <name>                 remove a file or a folder with its content
cp <source> <dest>        copy a file (dest may be a new name or a folder)
mv <source> <dest>        move or rename a file
get <local file>          import a file from the computer
put <file>                export a file to the computer
exit                      quit
Paths: name, folder/name, root/name, /name
